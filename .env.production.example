# ==============================================================================
# Vulnova Enterprise Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env.production on the production host.
# DO NOT commit actual production passwords, secret keys, or credentials to git.
# ==============================================================================

# Application Execution Mode
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# Application Domain & URLs
DOMAIN=vulnova.enterprise.com
NEXT_PUBLIC_API_URL=https://api.vulnova.enterprise.com/api/v1
CORS_ALLOWED_ORIGINS=https://vulnova.enterprise.com,https://app.vulnova.enterprise.com

# PostgreSQL Enterprise Database Settings
POSTGRES_USER=vulnova_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD_32_CHARS
POSTGRES_DB=vulnova_prod_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Database Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Cache & Broker Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD_32_CHARS
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# MinIO Object Storage Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=vulnova_minio_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_PASSWORD_32_CHARS
MINIO_BUCKET_NAME=vulnova-reports-prod
MINIO_USE_SSL=False

# Qdrant Vector Database Configuration
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=REPLACE_WITH_STRONG_QDRANT_API_KEY_32_CHARS

# Cryptographic & Authentication Secrets
# JWT secret must exceed 256 bits (32 bytes) of random entropy
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_JWT_SECRET_KEY_MINIMUM_64_HEX_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption at Rest Master Key (AES-256 Fernet)
ENCRYPTION_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_FERNET_MASTER_KEY

# Multi-Factor Authentication (MFA / TOTP)
MFA_ISSUER=VulnovaEnterprise

# Alert Escalation & Notification Integrations
PAGERDUTY_EVENTS_API_KEY=REPLACE_WITH_PAGERDUTY_INTEGRATION_KEY
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/WEBHOOK
SMTP_HOST=smtp.enterprise.com
SMTP_PORT=587
SMTP_USER=security-alerts@vulnova.enterprise.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_TLS=True

# Prometheus & Telemetry Exporter
PROMETHEUS_METRICS_ENABLED=True
METRICS_PORT=9090

# Disaster Recovery & WAL Archiving
WAL_ARCHIVE_DIR=/var/lib/postgresql/wal_archive
BACKUP_STORAGE_DIR=/var/backups/vulnova
BACKUP_RETENTION_DAYS=30
