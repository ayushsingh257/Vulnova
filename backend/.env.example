# Vulnova Backend Local Environment Configuration
APP_NAME=Vulnova Backend Control Plane
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=postgresql+asyncpg://vulnova_admin:vulnova_secure_password@localhost:5432/vulnova_db

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# Security Settings
JWT_SECRET=vulnova_super_secret_jwt_signing_key_min_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
