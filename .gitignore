*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs & System
*.log
uploads/
backend/uploads/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!backend/.env.example
!frontend/.env.example

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Temporary & runtime backup files
tmp/
scratch/
var/
backend/var/
*.enc
