# Vulnova — Environment Configuration Template
# DO NOT ADD REAL SECRETS TO THIS FILE.

# Application Settings
NODE_ENV=development
APP_NAME=Vulnova
LOG_LEVEL=INFO
PORT=8000

# Control Plane Database (PostgreSQL + pgvector)
POSTGRES_USER=vulnova_admin
POSTGRES_PASSWORD=vulnova_change_me_in_production
POSTGRES_DB=vulnova_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vulnova_admin:vulnova_change_me_in_production@localhost:5432/vulnova_db

# Task Broker & Cache (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Authentication & JWT Security
JWT_SECRET=vulnova_super_secret_jwt_signing_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & LLM Provider API Keys (Leave blank if using local Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Scanner Sandbox Isolation
SANDBOX_MAX_CPU=1.0
SANDBOX_MAX_MEMORY=512MB
SANDBOX_TIMEOUT_SECONDS=60
